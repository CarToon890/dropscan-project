<Window x:Class="DropScan.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DropScan — Local Transfer" Width="960" Height="720" MinWidth="800" MinHeight="600" Foreground="#182230" Background="#F5F6F8" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Leelawadee UI" UseLayoutRounding="True">
 <Grid Margin="32,20,32,16" SizeChanged="LayoutSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#2563EB" Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0"><Path Stroke="White" StrokeThickness="1.6" Data="M 9,10 L 9,24 L 25,24 L 25,15 M 14,16 L 23,7 M 16,7 L 23,7 L 23,14"/></Border><TextBlock Text="DropScan" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#E8EDF5" CornerRadius="5" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="LOCAL" Foreground="#526078" FontSize="10" FontWeight="Bold"/></Border></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ย่อไป Tray" Click="HideToTray" Margin="0,0,10,0"/><Button x:Name="HistoryButton" Content="ประวัติการแชร์" Click="OpenHistory" HorizontalAlignment="Right" Background="Transparent"/></StackPanel></Grid>
  <Grid x:Name="StepsBar" Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="StepOne" Background="#E8EFFF" CornerRadius="8" Padding="14,10" Margin="0,0,8,0"><TextBlock x:Name="StepOneLabel" Text="1   เลือกไฟล์" Foreground="#2563EB" FontWeight="SemiBold"/></Border><Border Grid.Column="1" x:Name="StepTwo" CornerRadius="8" Padding="14,10" Margin="0,0,8,0"><TextBlock x:Name="StepTwoLabel" Text="2   เตรียมแชร์" Foreground="#667085"/></Border><Border Grid.Column="2" x:Name="StepThree" CornerRadius="8" Padding="14,10"><TextBlock x:Name="StepThreeLabel" Text="3   รายการแชร์" Foreground="#667085"/></Border></Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="24">
   <Grid>
    <Grid x:Name="SelectPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="วันนี้อยากส่งไฟล์อะไร?" Style="{StaticResource Heading}"/><TextBlock Text="เลือกไฟล์จากเครื่องของคุณ เพื่อเตรียมรายการแชร์" Style="{StaticResource Secondary}"/></StackPanel>
     <Grid Grid.Row="1" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver" Background="Transparent">
      <Border x:Name="EmptyDrop" BorderBrush="#B7CBF6" BorderThickness="1" CornerRadius="12" Background="#F8FAFF"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Background="#EAF0FF" CornerRadius="12" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12"><Path Data="M 18,34 L 18,41 L 39,41 L 39,34 M 28,35 L 28,15 M 20,23 L 28,15 L 36,23" Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round"/></Border><TextBlock Text="ลากไฟล์มาวางที่นี่" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="เลือกไฟล์หรือโฟลเดอร์ ลากมาวางได้เลย" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PickButton" Content="เลือกไฟล์" Click="PickFiles" Margin="0,0,10,0"/><Button Content="เลือกโฟลเดอร์" Click="PickFolder"/></StackPanel></StackPanel></Border>
      <Grid x:Name="SelectedArea" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><TextBlock Text="ไฟล์ที่เลือก" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="เพิ่มโฟลเดอร์" Click="PickFolder" Padding="14,6" MinHeight="36" Margin="0,0,8,0"/><Button Content="เพิ่มไฟล์" Click="PickFiles" Padding="14,6" MinHeight="36"/></StackPanel></Grid><ListBox Grid.Row="1" x:Name="FileList" AutomationProperties.Name="ไฟล์ที่เลือก"><ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" BorderBrush="#E9EDF2" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="M 3,1 L 16,1 L 23,8 L 23,28 L 3,28 Z M 16,1 L 16,8 L 23,8 M 8,15 L 18,15 M 8,20 L 16,20" Stroke="#7385A0" StrokeThickness="1.4" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding ArchivePath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArchivePath}"/><TextBlock Text="{Binding SizeLabel}" Foreground="#667085" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="นำออก" Tag="{Binding}" Click="RemoveFile" Padding="10,6" MinHeight="34" FontSize="12" AutomationProperties.Name="นำไฟล์ออกจากรายการ"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
     </Grid>
     <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="SelectionError" Foreground="#B42318" Visibility="Collapsed" Margin="0,0,0,8"/><Grid><TextBlock x:Name="FileSummary" Text="ยังไม่ได้เลือกไฟล์" VerticalAlignment="Center" Style="{StaticResource Secondary}"/><Button x:Name="NextButton" Content="ถัดไป" Style="{StaticResource Primary}" Click="NextStep" IsEnabled="False" HorizontalAlignment="Right" MinWidth="112"/></Grid></StackPanel>
    </Grid>
    <Grid x:Name="PreparePanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="เตรียมรายการแชร์" Style="{StaticResource Heading}"/><TextBlock Text="ตรวจสอบรายการ แล้วเลือกเวลาที่ต้องการให้รับไฟล์ได้" Style="{StaticResource Secondary}" Margin="0,0,0,24"/><Border Background="#F5F8FF" CornerRadius="10" Padding="20" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PrepareSummary" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PrepareNames" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel></Border><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="เครือข่ายที่ใช้รับไฟล์" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="NetworkSelect" DisplayMemberPath="Label" Padding="8" FontSize="14" AutomationProperties.Name="เครือข่ายที่ใช้รับไฟล์"/></StackPanel><Button Grid.Column="1" Content="รีเฟรช" Click="RefreshNetworks" VerticalAlignment="Bottom" Margin="12,0,0,0"/></Grid><TextBlock Text="อายุรายการแชร์" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><RadioButton x:Name="ExpiryHour" GroupName="Expiry" Content="1 ชั่วโมง"/><RadioButton x:Name="ExpiryDay" GroupName="Expiry" Content="24 ชั่วโมง" IsChecked="True"/><RadioButton x:Name="ExpiryWeek" GroupName="Expiry" Content="7 วัน"/></WrapPanel><TextBlock Text="เมื่อหมดอายุ ลิงก์จะใช้ไม่ได้และการส่งที่กำลังทำงานจะหยุด" Style="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,14"/><CheckBox x:Name="PinEnabled" Content="ป้องกันรายการด้วย PIN 6 หลัก" FontWeight="SemiBold" Checked="TogglePin" Unchecked="TogglePin"/><Border x:Name="PinOptions" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,8"><StackPanel><TextBlock Text="PIN สำหรับส่งให้ผู้รับแยกจาก QR" Style="{StaticResource Secondary}" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBox x:Name="PinText" Width="130" MaxLength="6" FontSize="18" CharacterCasing="Upper" Padding="10,7" AutomationProperties.Name="PIN 6 หลัก"/><Button Content="สุ่มใหม่" Click="GeneratePin" Margin="10,0,0,0"/></StackPanel><TextBlock Text="ผู้รับต้องกรอก PIN ก่อนเห็นรายการและดาวน์โหลด • การส่งยังใช้ HTTP" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><CheckBox x:Name="ApprovalRequired" Content="ให้ฉันอนุมัติผู้รับก่อนเริ่มดาวน์โหลด" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="ผู้รับต้องส่งคำขอ และผู้ส่งมีเวลาอนุมัติภายใน 5 นาที" Style="{StaticResource Secondary}" FontSize="12" Margin="24,6,0,4"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock x:Name="PrepareError" Foreground="#B42318" Visibility="Collapsed" Margin="0,0,0,8"/><Grid><Button Content="ย้อนกลับ" Click="PreviousStep" HorizontalAlignment="Left"/><Button x:Name="CreateButton" Content="เริ่มแชร์ไฟล์" Style="{StaticResource Primary}" Click="CreateShare" HorizontalAlignment="Right"/></Grid></StackPanel></Grid>
    <Grid x:Name="ResultPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock x:Name="ShareTitle" Text="พร้อมให้รับไฟล์" Style="{StaticResource Heading}"/>
      <TextBlock x:Name="ShareDetails" Style="{StaticResource Secondary}" Margin="0,0,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><Border x:Name="QrFrame" Background="White" BorderBrush="#DCE5F3" BorderThickness="1" CornerRadius="10" Padding="4"><Image x:Name="QrImage" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR Code สำหรับรับไฟล์"/></Border><TextBlock Text="สแกนด้วยกล้องมือถือเพื่อรับไฟล์" FontSize="12" TextAlignment="Center" Foreground="#667085" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="ลิงก์รับไฟล์" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="ShareCode" IsReadOnly="True" TextWrapping="Wrap" Background="#F5F8FF" BorderBrush="#DCE5F3" Padding="10" FontSize="13" AutomationProperties.Name="ลิงก์รับไฟล์"/><StackPanel x:Name="PinResultPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="PIN สำหรับแจ้งผู้รับแยกจาก QR" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBox x:Name="SharePin" Width="130" IsReadOnly="True" FontSize="18" Padding="10,7" AutomationProperties.Name="PIN สำหรับผู้รับ"/><Button Content="คัดลอก PIN" Click="CopyPin" Margin="10,0,0,0"/></StackPanel></StackPanel><StackPanel x:Name="ApprovalPanel" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="คำขอรับไฟล์" FontWeight="SemiBold"/><TextBlock x:Name="ApprovalEmpty" Text="ยังไม่มีคำขอ • รอผู้รับสแกน QR และส่งคำขอ" Style="{StaticResource Secondary}" FontSize="12" Margin="0,5,0,0"/><ListBox x:Name="ApprovalList" MaxHeight="170" BorderThickness="0" Margin="0,6,0,0" AutomationProperties.Name="คำขอรับไฟล์"><ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel><Grid><TextBlock Text="{Binding ClientLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" Foreground="#526078" FontSize="12"/></Grid><TextBlock Text="{Binding TimeLabel}" Foreground="#667085" FontSize="11" Margin="0,3,0,7"/><StackPanel Orientation="Horizontal"><Button Content="อนุมัติ" Tag="{Binding}" Click="ApproveRecipient" IsEnabled="{Binding IsPending}" Padding="10,5" MinHeight="32"/><Button Content="ปฏิเสธ" Tag="{Binding}" Click="DenyRecipient" IsEnabled="{Binding IsPending}" Padding="10,5" MinHeight="32" Margin="7,0,0,0"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><TextBlock x:Name="TransferStatus" FontWeight="SemiBold" Margin="0,16,0,8"/><ProgressBar x:Name="TransferProgress" Height="6" Maximum="100" Foreground="#2563EB" Background="#E8EFFF" BorderThickness="0"/><TextBlock x:Name="TransferDetails" FontSize="12" Foreground="#667085" Margin="0,8,0,0"/><TextBlock x:Name="ResultStatus" Foreground="#2563EB" FontSize="12" Margin="0,10,0,0"/></StackPanel>
      </Grid>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="ยกเลิกการส่ง" Click="CancelDownloads" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="CopyButton" Content="คัดลอกลิงก์" Click="CopyCode" Margin="0,0,10,0" Style="{StaticResource Primary}"/><Button x:Name="StopButton" Content="หยุดแชร์" Click="StopShare"/><Button x:Name="RestartButton" Content="เริ่มรายการใหม่" Click="Restart" Style="{StaticResource Primary}" Visibility="Collapsed"/></StackPanel>
    </Grid>
    <Grid x:Name="HistoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="ประวัติการแชร์" Style="{StaticResource Heading}"/><TextBlock x:Name="HistoryNotice" Text="ประวัติการแชร์ล่าสุด" Style="{StaticResource Secondary}"/></StackPanel><Grid Grid.Row="1"><StackPanel x:Name="HistoryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="ยังไม่มีรายการแชร์" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="รายการที่สร้างจะแสดงที่นี่" Style="{StaticResource Secondary}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel><ListBox x:Name="HistoryList" AutomationProperties.Name="ประวัติการแชร์"><ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="8" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,16,0"/></StackPanel><Border Grid.Column="1" Background="#EAF0FA" CornerRadius="5" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontSize="12" Foreground="#46618A"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><Button Grid.Row="2" x:Name="ReturnButton" Content="กลับไปหน้าส่งไฟล์" Click="CloseHistory" HorizontalAlignment="Left" Margin="0,16,0,0"/></Grid>
   </Grid>
  </Border>
  <TextBlock Grid.Row="3" Text="ส่งตรงใน Wi-Fi/LAN เดียวกัน • ให้เครื่องผู้ส่งเปิดอยู่ • PIN/การอนุมัติยังใช้ HTTP" Foreground="#667085" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0"/>
 </Grid>
</Window>





